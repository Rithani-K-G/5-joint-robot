<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="five_joint_robot">

  <!--
    CAD-derived 4-DOF arm (five physical CAD bodies), excluding the gripper.
    Link/joint frames are derived from RobotFrame.xml concentric constraints
    and the assembled component transforms. The assembled CAD pose is q=0.
    STL meshes were exported from millimetre-based STEP files; scale 0.001
    assumes the exported STL vertex coordinates remain in millimetres.
  -->

  <xacro:arg name="controllers_file" default=""/>

  <!-- Alternating dark/light grey appearance: Base, Waist, Arm01, Arm02, Arm03. -->
  <material name="dark_grey">
    <color rgba="0.22 0.22 0.23 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.72 0.72 0.74 1.0"/>
  </material>

  <!-- World anchor. base_link is the root mechanical body. -->
  <link name="world"/>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.000000008547 0.001096992 0.022106105" rpy="0 0 0"/>
      <mass value="0.0945948718"/>
      <inertia ixx="1.348301727e-4" ixy="-3.759313413e-6" ixz="2.524361046e-11"
               iyy="1.288596136e-4" iyz="-6.169501087e-11" izz="2.056402545e-4"/>
    </inertial>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Waist: child frame is the CAD-derived J1 frame. -->
  <link name="waist_link">
    <visual>
      <origin xyz="0 0 -0.02475" rpy="-1.570796327 0 2.433104987"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Waist.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02475" rpy="-1.570796327 0 2.433104987"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Waist.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.004761 0.005962 -0.044133" rpy="0 0 0"/>
      <mass value="0.0736481704"/>
      <inertia ixx="6.0220e-5" ixy="-8.7700e-6" ixz="-9.2700e-7"
               iyy="5.8016e-5" iyz="9.2620e-6" izz="6.0133e-5"/>
    </inertial>
  </link>

  <!-- Arm 01: child frame is the CAD-derived J2 frame. -->
  <link name="arm_01_link">
    <visual>
      <origin xyz="0 0 0.0286" rpy="-3.141592654 0 -0.159097"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Arm_01.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0286" rpy="-3.141592654 0 -0.159097"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Arm_01.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.009505 -0.059242 0.015371" rpy="0 0 0"/>
      <mass value="0.06406206296"/>
      <inertia ixx="1.01382e-4" ixy="-1.47860e-5" ixz="0"
               iyy="1.16010e-5" iyz="0" izz="1.08625e-4"/>
    </inertial>
  </link>

  <!-- Arm 02: child frame is the CAD-derived J3 frame. -->
  <link name="arm_02_link">
    <visual>
      <origin xyz="0.004527 -0.034454 0.0004" rpy="-3.141592654 0 -1.440155"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Arm_02.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0.004527 -0.034454 0.0004" rpy="-3.141592654 0 -1.440155"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Arm_02.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.005465 -0.041351 -0.00532" rpy="0 0 0"/>
      <mass value="0.04709817859"/>
      <inertia ixx="5.0677e-5" ixy="5.5130e-6" ixz="-1.7000e-8"
               iyy="9.4470e-6" iyz="-4.0900e-7" izz="5.4665e-5"/>
    </inertial>
  </link>

  <!-- Arm 03: final arm body; gripper deliberately omitted. -->
  <link name="arm_03_link">
    <visual>
      <origin xyz="0.002235 0.004473 0.014792" rpy="1.570796327 0 1.107371"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Arm_03.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0.002235 0.004473 0.014792" rpy="1.570796327 0 1.107371"/>
      <geometry>
        <mesh filename="package://five_joint_description/cad/Arm_03.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.002459 0.00687 0.0326" rpy="0 0 0"/>
      <mass value="0.01647038115"/>
      <inertia ixx="4.790e-6" ixy="-4.410e-7" ixz="-2.680e-7"
               iyy="4.118e-6" iyz="-5.110e-7" izz="2.609e-6"/>
    </inertial>
  </link>

  <!-- Four revolute joints: J1 yaw, J2/J3 pitch, J4 wrist. -->
  <joint name="base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="waist_link"/>
    <origin xyz="0 0 0.03275" rpy="3.141592654 0 -1.749714"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592654" upper="3.141592654" effort="5.0" velocity="1.0"/>
  </joint>

  <joint name="shoulder_joint" type="revolute">
    <parent link="waist_link"/>
    <child link="arm_01_link"/>
    <origin xyz="0.001154 0.01733 -0.06503" rpy="1.570796327 -0.284039 0.862309"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="6.283185307" effort="5.0" velocity="1.0"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="arm_01_link"/>
    <child link="arm_02_link"/>
    <origin xyz="-0.019011 -0.118484 0.006" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-4.712388980" upper="4.712388980" effort="5.0" velocity="1.0"/>
  </joint>

  <joint name="wrist_joint" type="revolute">
    <parent link="arm_02_link"/>
    <child link="arm_03_link"/>
    <origin xyz="0.004666 -0.076199 -0.0051" rpy="1.570796327 -0.846295 0.130641"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796327" upper="1.570796327" effort="5.0" velocity="1.0"/>
  </joint>

  <!-- ros2_control interfaces for Gazebo Harmonic / gz_ros2_control. -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="base_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

</robot>
