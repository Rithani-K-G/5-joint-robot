<?xml version="1.0"?>
<robot name="five_joint_robot">

  <!-- Arm planning group -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- Home position -->
  <group_state name="home" group="arm">
    <joint name="base_joint" value="0.0"/>
    <joint name="shoulder_joint" value="0.0"/>
    <joint name="elbow_joint" value="0.0"/>
    <joint name="wrist_joint" value="0.0"/>
  </group_state>

  <!-- Adjacent link collision exclusions -->

  <disable_collisions
      link1="base_link"
      link2="shoulder_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="shoulder_link"
      link2="upper_arm_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="upper_arm_link"
      link2="forearm_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="forearm_link"
      link2="wrist_link"
      reason="Adjacent"/>

  <disable_collisions
      link1="wrist_link"
      link2="tool0"
      reason="Adjacent"/>

</robot>
